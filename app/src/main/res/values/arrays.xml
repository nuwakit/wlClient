<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="time_unit_array">
        <item>@string/unit_minute</item>
        <item>@string/unit_hour</item>
        <item>@string/unit_day</item>
    </string-array>

    <string-array name="play_mode_array">
        <item>@string/play_mode_flexible</item>
        <item>@string/play_mode_together</item>
    </string-array>

    <!--
        每次批量入场连打几场（对应 ArenaConfig.enterRounds）。

        出厂默认 1 场（ArenaConfig.DEFAULT_ENTER_ROUNDS）：点一次打一场，
        沿用旧版「充值 + 入场」成对点的节奏，每点完就能看到这一局的输赢。
        想少点几次就自己调到 10 或 12，配置只需设一次。
        12 是合约硬上限（MAX_ENTRIES_PER_DAY），也是当日满勤。

        标注规则：「不建议」= 12 ÷ 场数 除不尽。
        除不尽意味着想打满 12 场就得多点一次，而最后那一次里有一部分圈会撞
        「今日已打满 12 场」空跑一遍封盘等待。能整除的 1/2/3/4/6/12 一次点到位。

        10 是唯一的例外语义：它是结构收益的封顶线（FULL_ACTIVITY_MATCHES = 10），
        目标就是「每天打 10 场收工」时选它完全正确；标「不建议」只是提醒
        「别拿它去凑 12 场」。11 场两个问题都占：既超过满勤线（结构收益已封顶），又除不尽。
        第 11、12 场并非「零收益」，抽奖与师承加成还在涨，完整算式只写在
        ArenaConfig.MAX_ENTRIES_PER_DAY 的注释里，这里不重抄。

        文本只用于显示：取值一律按「下拉索引 + 1」，见 AutoClearConfigActivity#saveConfigs。
    -->
    <string-array name="enter_rounds_array">
        <item>1 场（默认）</item>
        <item>2 场</item>
        <item>3 场</item>
        <item>4 场</item>
        <item>5 场（不建议）</item>
        <item>6 场</item>
        <item>7 场（不建议）</item>
        <item>8 场（不建议）</item>
        <item>9 场（不建议）</item>
        <item>10 场（满勤·不建议）</item>
        <item>11 场（超过满勤·不建议）</item>
        <item>12 场（每日上限）</item>
    </string-array>

    <!--
        批量转账的分配方式（对应 ArenaConfig.transferMode）。

        索引必须与 ArenaConfig.TRANSFER_MODE_RATIO / TRANSFER_MODE_AMOUNT 一一对应，
        所以这一项只能加在末尾，中间插位会静默改变已有配置的含义。

        两个值都保存在收款方管理里（ratio 与 amount 各一列），切模式不会丢另一边已填的数据。
    -->
    <string-array name="transfer_mode_array">
        <item>@string/transfer_mode_ratio</item>
        <item>@string/transfer_mode_amount</item>
    </string-array>

    <!--
        补币模式（对应 ArenaConfig.fundMode）：接在连打场数下面。

        索引必须与 ArenaConfig.FUND_MODE_SINGLE / FUND_MODE_MULTI 一一对应，
        所以这一项只能加在末尾，中间插位会静默改变已有配置的含义。

        单场足额：每次入场只补到 100 fLGNS（门票）；多场足额：按圈数查表预留
        （连打 2 场补到 200，旧版唯一行为）。默认单项 = 单场足额。
    -->
    <string-array name="fund_mode_array">
        <item>@string/fund_mode_single</item>
        <item>@string/fund_mode_multi</item>
    </string-array>
</resources>
