    <string name="auto_clear_tv_enter_rounds_label">连打场数</string>

    <!--
        批量转账卡片（对应 ArenaConfig.transferMode）：接在连打场数下面。
        下拉两项的文本同时被 arrays.xml 的 transfer_mode_array 引用，索引不能调位。
    -->
    <string name="auto_clear_tv_transfer_mode_label">批量转账</string>
    <string name="transfer_mode_ratio">按收益比例（默认）</string>
    <string name="transfer_mode_amount">按收益数额</string>
