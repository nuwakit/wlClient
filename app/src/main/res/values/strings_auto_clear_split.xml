    <string name="auto_clear_status_pair_fmt">私钥 %1$s · 日志 %2$s</string>
    <!-- 标题栏「⚠」弹窗标题，同时用作该图标的无障碍描述 -->
    <string name="auto_clear_tip_dialog_title">清理规则说明</string>

