<?xml version="1.0" encoding="utf-8"?>
<!-- 统收盟福按钮背景：江湖福泽风格——墨青起、碧色承、鎏金收的横向渐变，
     与批量铸造（绛红镶金）同系但配色区分「福泽」；圆角与其它批量按钮保持一致的 8dp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="8dp" />
    <gradient
        android:angle="0"
        android:startColor="#0D4F4F"
        android:centerColor="#00695C"
        android:endColor="#D89A2E"
        android:type="linear" />
</shape>
