<?xml version="1.0" encoding="utf-8"?>
<!-- 师傅 新增/编辑 弹窗：地址 + 编号 + 分组 + 设为主师傅（仅编辑时显示）；
     与归集接收方编辑弹窗同构，内容控件用独立 id 防止与归集弹窗混淆 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <!-- 头部：图标徽标 + 标题 + 副标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_icon_badge"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_menu_addr_svg"
                app:tint="@color/primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                style="@style/DialogTitleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/master_add_title" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/DialogSubtitleStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/master_edit_subtitle"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 师傅地址（收徒方地址是手填的，与归集接收方一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_hash_svg"
            app:tint="#FF90A4AE" />

        <EditText
            android:id="@+id/et_master_address"
            style="@style/DialogInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/master_hint_address"
            android:inputType="text"
            android:maxLength="42"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 编号 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_edit_svg"
            app:tint="#FF90A4AE" />

        <EditText
            android:id="@+id/et_master_code"
            style="@style/DialogInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_custom_code"
            android:inputType="text"
            android:maxLength="10"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 分组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_group_svg"
            app:tint="#FF90A4AE" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <Spinner
                android:id="@+id/sp_master_group"
                style="@style/AppSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dropdown_arrow_svg" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 设为主师傅：新增时隐藏（第一条自动成为主师傅），编辑时显示 -->
    <LinearLayout
        android:id="@+id/layout_set_master"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cb_set_master"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/master_label_set"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_master_err"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFD32F2F"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 自绘按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_mst_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_cancel"
            android:textColor="#FF616161"
            android:textSize="14sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_mst_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
