<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- 标题栏：与各子页同一套框架（primary 蓝底 / 56dp / 白字 17sp 标题 / 11sp 副标题），
         从子页返回时不再出现「蓝底 56dp → 白底 48dp」的跳变。
         左侧用 App 图标顶替子页返回键的位置，右侧文字入口收成胶囊徽标、溢出菜单补足 44dp 热区。 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lgns" />

        <!-- 标题 + 状态副标题：副标题由 refreshStatusSubtitle() 按「加载/同步/失败/运行中/就绪」切换 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/main_status_loading"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 安全提醒：文字按钮 → 半透明胶囊 + 14dp 琥珀色三角，保留可读标签又不抢标题权重 -->
        <TextView
            android:id="@+id/btn_security_warn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_pill_white_ripple"
            android:clickable="true"
            android:drawableStart="@drawable/ic_warning_pill"
            android:drawablePadding="3dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/main_btn_security_warn"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <!-- 溢出菜单（⋮）：对应 gear_pop_menu 的混合功能项（密钥/分组/日志/模式/统计），
             语义上是「更多」而非「设置」，故用 Material 标准 more_vert；真正设置项才用齿轮。 -->
        <ImageButton
            android:id="@+id/btn_setting_gear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple_white_circle"
            android:contentDescription="@string/common_cd_more_settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- 汇总数据卡：从「通栏白条」收成卡片，和蓝色标题栏拉开层次；padding 保持 8dp，高度不增 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_summary_enter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />
                <TextView
                    android:id="@+id/tv_summary_enter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/common_label_today_enter"
                    android:textSize="10sp"
                    android:textColor="#757575" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#E0E0E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_summary_today_win"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF5722" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_label_today_champion"
                    android:textSize="10sp"
                    android:textColor="#757575" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#E0E0E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_summary_total_win"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E65100" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_label_total_champion"
                    android:textSize="10sp"
                    android:textColor="#757575" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#E0E0E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_summary_prize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_label_total_prize"
                    android:textSize="10sp"
                    android:textColor="#757575" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 列表级同步进度：两波查询（主体数据 + 今日冠军）各占一半，走完自动隐藏 -->
    <ProgressBar
        android:id="@+id/pb_stats_sync"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#4CAF50"
        android:progressBackgroundTint="#EEEEEE"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_account_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/btn_batch_enter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_rounded"
            android:backgroundTint="#1976D2"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_enter_svg"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/tv_btn_enter_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_btn_batch_enter"
                android:textColor="#ffffff"
                android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="4dp" android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/btn_batch_claim"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_rounded"
            android:backgroundTint="#388E3C"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_claim_svg"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/tv_btn_claim_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_btn_batch_claim"
                android:textColor="#ffffff"
                android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="4dp" android:layout_height="0dp" />

        <!-- 批量铸造（盟主令）：武林盟主风格——绛红鎏金渐变底 + 盟主令牌图标 + 鎏金文字。
             不设 backgroundTint：MainActivity 记录的原始 tint 为 null，置灰靠 alpha、
             恢复靠 setBackgroundTintList(null)（渐变自现），停止键纯色 tint 会盖住渐变仍可视 -->
        <LinearLayout
            android:id="@+id/btn_batch_mint"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_batch_mint"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mandate_token_svg"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/tv_btn_mint_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_btn_batch_mint"
                android:textColor="#FFE082"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="4dp" android:layout_height="0dp" />

        <!-- 统收盟福（批量领取福泽）：与铸造同风格——青绿鎏金渐变底 + 礼盒图标 + 鎏金文字。
             不设 backgroundTint：停止置灰靠 alpha、恢复靠 setBackgroundTintList(null)，与铸造同套路。
             原「完整流程」按钮已收入 ⋮ 菜单（日志管理下方） -->
        <LinearLayout
            android:id="@+id/btn_batch_fuze"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_batch_fuze"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_fuze_svg"
                android:layout_marginEnd="4dp" />
            <TextView
                android:id="@+id/tv_btn_fuze_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_btn_batch_fuze"
                android:textColor="#FFE082"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/layout_log_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_log_svg"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/common_label_running_log"
                android:textSize="13sp"
                android:textColor="#424242"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="12sp"
                android:textColor="#9E9E9E" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#F8F9FA"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#37474F"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>