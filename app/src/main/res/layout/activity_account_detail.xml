<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6F8"
    tools:ignore="Overdraw">

    <!-- 标题栏：返回 + 标题 + 本页操作（入场 / 领取 / 刷新，半透明白胶囊） + 加载指示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_svg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/common_title_account_detail"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/pb_detail_loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone" />

        <!-- 触摸区撑到 48dp（Material 无障碍下限），视觉胶囊仍是 30dp：
             外层只负责接收点击（Java 里的 setEnabled/setAlpha 全部作用在它身上），内层只画外观。
             这层嵌套是刻意的，不是冗余，所以三个按钮都就地 ignore 了 UselessParent -->
        <FrameLayout
            android:id="@+id/btn_d_enter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_translucent"
                android:paddingStart="8dp"
                android:paddingEnd="9dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_enter_svg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_btn_enter"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_d_claim"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_translucent"
                android:paddingStart="8dp"
                android:paddingEnd="9dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_claim_svg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_btn_claim"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_d_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_translucent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/detail_refresh"
                    android:src="@drawable/ic_refresh_svg" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 详情区：账号头 + 入场详情 + 领取详情，整体可滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 账号头：密钥徽标 + 自编号 + 简短地址 + 分组 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_soft"
                    android:backgroundTint="#E3F2FD">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/common_title_account_detail"
                        android:src="@drawable/ic_key_svg"
                        app:tint="#1976D2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_d_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_placeholder"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#1A2233" />

                        <TextView
                            android:id="@+id/tv_d_addr"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/common_placeholder"
                            android:textSize="11sp"
                            android:textColor="@color/text_hint"
                            android:fontFamily="monospace"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_d_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/common_ungrouped"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_tag_gray"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════ 入场详情 ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_accent_bar"
                    android:backgroundTint="#1976D2" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/detail_section_enter"
                    android:src="@drawable/ic_enter_svg"
                    app:tint="#1976D2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/detail_section_enter"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_enter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="16dp" />

            <!-- ══════ 领取详情 ══════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_accent_bar"
                    android:backgroundTint="@color/claim_green" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/detail_section_claim"
                    android:src="@drawable/ic_claim_svg"
                    app:tint="@color/claim_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/detail_section_claim"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/claim_green" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_claim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部日志区：对标主界面下方日志，入场/领取过程在此上屏并落库；点标题行折叠/展开，默认收起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <LinearLayout
            android:id="@+id/ll_detail_log_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/common_label_running_log"
                android:src="@drawable/ic_log_svg"
                app:tint="#546E7A"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/common_label_running_log"
                android:textSize="13sp"
                android:textColor="#424242"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_log_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arrow_collapsed"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_detail_log"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="#F7F8FA"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_detail_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#37474F"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
