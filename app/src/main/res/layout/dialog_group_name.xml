<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- 标题行：图标徽标 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_dialog_icon_badge"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_group_svg"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_title"
            style="@style/DialogTitleStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/dialog_add_group_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_subtitle"
        style="@style/DialogSubtitleStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/dialog_group_name_subtitle" />

    <!-- 输入区：圆角输入框 + 右下角字数计数 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <EditText
            android:id="@+id/et_group_name"
            style="@style/DialogInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_group_name"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="10"
            android:maxLines="1"
            android:paddingEnd="56dp" />

        <TextView
            android:id="@+id/tv_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            tools:text="0/10" />
    </RelativeLayout>

    <!-- 内联错误提示（校验失败时显示，替代 Toast） -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="2dp"
        android:textColor="#E53935"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="分组名已存在"
        tools:visibility="visible" />

    <!-- 自绘按钮行：避免系统按钮栏在 AppDialog 下贴边 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_grp_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_cancel"
            android:textColor="#FF616161"
            android:textSize="14sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_grp_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
