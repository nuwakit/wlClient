<?xml version="1.0" encoding="utf-8"?>
<!--
  齿轮菜单：定宽卡片 + 柔和投影（MaterialCardView 自带 elevation，窗口四周留 14dp 给阴影）
  一级项 46dp；「充值管理」「转账管理」是可展开分组，子项缩进一档 42dp，同时只展开一组
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="212dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!--
                任务运行中的只读提示：默认 GONE，由 MainMenuHelper 按 isBatchTaskRunning() 切换。
                此时下面的写操作项全部置灰，留一行字解释原因，避免用户以为什么都点不了
            -->
            <TextView
                android:id="@+id/tv_menu_readonly_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/menu_readonly_hint"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- 第一组：账号数据（分组管理置顶） -->

            <LinearLayout
                android:id="@+id/menu_group_manage"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pop_menu_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_pop_menu_icon">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_menu_group_svg"
                        app:tint="#FF1976D2" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.01"
                    android:text="@string/common_title_group_manage"
                    android:textColor="#FF1F2937"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
