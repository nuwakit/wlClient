<?xml version="1.0" encoding="utf-8"?>
<!-- 批量拜师页：结构与批量归集页一致，方向同为多对一（多个门徒 → 一个主师傅）；
     上半部分头部卡是主师傅，下半部分明细是各门徒的拜师状态 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F7FA">

    <!-- 顶部栏：与批量归集页统一 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_svg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_batch_apprentice"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 右上角：去门徒管理维护名单 -->
        <ImageButton
            android:id="@+id/btn_manage_disciple"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_manage_disciple"
            android:padding="8dp"
            android:src="@drawable/ic_gear_svg"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- 主师傅卡 + 门徒明细（头部随列表滚动） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_apprentice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/layout_footer"
        android:layout_below="@id/toolbar"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:visibility="invisible" />

    <!-- 加载中 / 空态 / 查询失败 占位：与列表同区域，切换时页面不跳动 -->
    <LinearLayout
        android:id="@+id/layout_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/layout_footer"
        android:layout_below="@id/toolbar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <ProgressBar
            android:id="@+id/pb_state"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/tv_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_state_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_state_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="center"
            android:minWidth="128dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#616161"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 底部操作栏：与批量归集页同构，只留按钮 -->
    <LinearLayout
        android:id="@+id/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_cancel"
            android:textColor="#616161"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_fund_svg"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_apprentice_confirm"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
