<?xml version="1.0" encoding="utf-8"?>
<!--
    系统配置页：清理规则 + 入场模式 + 当前状态 + 数据维护。
    说明文字不再常驻页面，全部收进标题栏「⚠」的规则弹窗，页面只留可操作控件；
    数据维护卡固定在底部（不随 ScrollView 滚动），避免小屏必须下拉才看得到。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- 顶部栏：返回 / 标题 / 规则说明 / 保存 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_svg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/common_title_system_config"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 规则说明入口：替代原页面顶部的黄色提示条，点击弹窗查看 -->
        <ImageButton
            android:id="@+id/btn_tip_warning"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auto_clear_tip_dialog_title"
            android:scaleType="centerInside"
            android:src="@drawable/ic_warning_svg" />

        <!-- 保存：文字改为图标，省出标题栏横向空间 -->
        <ImageButton
            android:id="@+id/btn_save_auto_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_save"
            android:scaleType="centerInside"
            android:src="@drawable/ic_save_svg" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 私钥自动清除：开关与间隔合并到同一张卡，省掉一整块开关卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_clear_key_switch_label"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_auto_enable"
                            style="@style/AppSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- 间隔输入行：开关关闭时整行由 applyKeyIntervalEnabled 置灰 -->
                    <LinearLayout
                        android:id="@+id/layout_time_setting"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 左侧输入区固定 108dp：入场模式卡用同一宽度做标签列，
                             三张卡的下拉框才能落在同一条左边缘上（不随“每”字宽度漂移） -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_auto_clear_val"
                                style="@style/DialogInputStyle"
                                android:layout_width="76dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:hint="@string/auto_clear_et_value_hint"
                                android:inputType="number"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/auto_clear_tv_unit_per"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <Spinner
                                android:id="@+id/sp_time_unit"
                                style="@style/AppSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:entries="@array/time_unit_array" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_dropdown_arrow_svg" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 入场：模式与连打场数同属“怎么打”，压在一张卡里分两行 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <!-- 第一行：入场模式。标签列与上面两卡的输入区同宽 108dp，下拉框左边缘因此对齐 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="108dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/auto_clear_tv_enter_mode_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <Spinner
                                android:id="@+id/sp_play_mode"
                                style="@style/AppSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:entries="@array/play_mode_array" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_dropdown_arrow_svg" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- 第二行：每次连打几场。师徒分成按当日场次 10%/场解锁，只打一场只能领一成 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="108dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/auto_clear_tv_enter_rounds_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <Spinner
                                android:id="@+id/sp_enter_rounds"
                                style="@style/AppSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:entries="@array/enter_rounds_array" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_dropdown_arrow_svg" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--
                批量转账：接在连打场数下面，单独一张卡。
                不跟入场挤在同一张卡里，是因为那张卡的语义是「怎么打」，分钱方式不属于它。
                标签列仍用 108dp，下拉框左边缘才能与上面几张卡对齐。
            -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="108dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/auto_clear_tv_transfer_mode_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <Spinner
                                android:id="@+id/sp_transfer_mode"
                                style="@style/AppSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:entries="@array/transfer_mode_array" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_dropdown_arrow_svg" />
                        </RelativeLayout>
                    </LinearLayout>

                    <!-- 一句话说明当前模式怎么分钱，随下拉选择实时切换 -->
                    <TextView
                        android:id="@+id/tv_transfer_mode_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <!-- 自动补币开关：开则批量入场前先由主号补齐门票（ArenaConfig.autoReplenishEnable）。
                         默认勾选：与字段默认值一致，避免配置加载前首帧显示成关闭 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_clear_tv_auto_replenish_label"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_auto_replenish"
                            style="@style/AppSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/auto_clear_auto_replenish_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 日志自动清除：与私钥卡同一套结构，两行对齐 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_clear_log_switch_label"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <!-- 默认勾选：与 ArenaConfig.logClearEnable 的默认值一致，
                             避免配置加载前首帧显示成关闭 -->
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/sw_log_clear_enable"
                            style="@style/AppSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- 保留间隔行：开关关闭时整行由 applyLogIntervalEnabled 置灰 -->
                    <LinearLayout
                        android:id="@+id/layout_log_interval"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 与私钥卡同宽 108dp，保证两张卡的间隔下拉框左边缘一致 -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_log_clear_val"
                                style="@style/DialogInputStyle"
                                android:layout_width="76dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:hint="@string/auto_clear_et_value_hint"
                                android:inputType="number"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/auto_clear_tv_unit_per"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <Spinner
                                android:id="@+id/sp_log_time_unit"
                                style="@style/AppSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:entries="@array/time_unit_array" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_dropdown_arrow_svg" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 当前状态：单行摘要，私钥与日志状态一起显示 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/auto_clear_tv_status_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_auto_clear_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/state_disabled"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 数据维护：排在当前状态下面，随页面滚动；影响范围在确认弹窗里说明 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning_svg"
                        app:tint="@color/danger" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/db_init_section_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_init_db"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_btn_danger"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/db_init_button"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>