<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络、前台服务、通知权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--前台服务权限，Android12+必须-->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_lgns"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WlClient"
        tools:targetApi="31">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.GroupManageActivity"
            android:exported="false"
            android:label="分组管理" />

        <activity
            android:name=".ui.activity.PrivateKeyManageActivity"
            android:exported="false"
            android:label="私钥管理" />

        <activity
            android:name=".ui.activity.LogViewActivity"
            android:exported="false"
            android:label="运行日志" />

        <activity
            android:name=".ui.activity.ChampionshipStatsActivity"
            android:exported="false"
            android:label="锦标赛统计" />

        <activity
            android:name=".ui.activity.AccountDetailActivity"
            android:exported="false"
            android:label="@string/common_title_account_detail" />

        <activity
            android:name=".ui.activity.AutoClearConfigActivity"
            android:exported="false"
            android:label="自动清除配置" />

        <activity android:name=".ui.activity.BatchFundConfirmActivity" />

        <activity
            android:name=".ui.activity.AddressManageActivity"
            android:exported="false"
            android:label="接收方管理" />

        <activity
            android:name=".ui.activity.PayerManageActivity"
            android:exported="false"
            android:label="支付方管理" />

        <activity
            android:name=".ui.activity.BatchGasFundActivity"
            android:exported="false"
            android:label="批量充值手续费" />

        <activity
            android:name=".ui.activity.BatchTransferActivity"
            android:exported="false"
            android:label="批量转账" />

        <activity
            android:name=".ui.activity.TransferListActivity"
            android:exported="false"
            android:label="@string/txn_title_list" />

        <activity
            android:name=".ui.activity.TransferDetailActivity"
            android:exported="false"
            android:label="@string/txn_title_detail" />
    </application>
</manifest>
